FEDOPS_CLIENT_PERFORMANCE_URL=http://performance.example.invalid:8001
FEDOPS_AGGREGATION_HOST=fl.example.invalid
# FEDOPS_AGGREGATION_SERVER=fl.example.invalid:40026
REGION_NAME=ap-northeast-2
BUCKET_NAME=global-model
